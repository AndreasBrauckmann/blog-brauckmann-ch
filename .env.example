# Kopieren nach .env und ausfüllen. .env selbst niemals committen (in .gitignore).

# Verwaltungsseite (scripts/admin/app.py): kein Passwort noetig - nur
# ueber den Kontor-edge-Caddy erreichbar (Tailnet+LAN), siehe die
# Modul-Docstring dort.

# Mastodon: Einstellungen -> Entwicklung -> Neue Anwendung, Scope "write:statuses"
MASTODON_ACCESS_TOKEN=

# Bluesky: Einstellungen -> App-Passwörter -> neues App-Passwort erzeugen
# (nicht das normale Account-Passwort verwenden)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# LinkedIn: Developer Portal -> App -> Produkte "Share on LinkedIn" und
# "Sign In with LinkedIn using OpenID Connect" aktivieren, App über eine
# Company-Page verifizieren, dann OAuth-Flow durchlaufen
# (siehe scripts/social/linkedin_auth.py).
# Token läuft nach ~60 Tagen ab, muss dann erneuert werden.
LINKEDIN_ACCESS_TOKEN=

# X/Twitter: aktuell nicht genutzt (config.yaml: channels.x.enabled = false).
# X_BEARER_TOKEN=

# LLM fuer Auto-Analyse, Lektorat und Meta-Vorschlaege der Verwaltung
# (scripts/admin/llm.py), OpenAI-kompatibel: claude-wrapper auf dem Pi.
# Ohne Schluessel laufen alle regelbasierten Teile weiter.
BLOG_LLM_API_KEY=
BLOG_LLM_BASE_URL=http://127.0.0.1:8001/v1
# Modellstufen nach Aufgabe (fehlt eine Stufe, gilt die naechstniedrigere):
# BLOG_LLM_MODEL_STARK=claude-opus-4-6   # Lektorat, Textueberarbeitung, Gegenlesen (Vorgabe)
# BLOG_LLM_MODEL_MAX=                    # Tiefenanalyse; leer = wie STARK
BLOG_LLM_MODEL=claude-sonnet-4-6

# Quick-Redaktor (scripts/admin/redaktor_views.py, /verwaltung/redaktor intern,
# /redaktor nach einer Freigabe; Vorschlag: docs-intern/redaktor-freigabe.md).
# Gemeinsamer Zugangscode fuer die Kollegen. Leer = niemand kann sich anmelden.
# REDAKTOR_CODE=<langer-zufaelliger-code>
# KI-Verbesserung: nur der ausdrueckliche Wert "abo" schaltet sie ein (Anfragen
# laufen dann ueber das persoenliche Claude-Abo via claude-wrapper; ob das fuer
# andere Personen zulaessig ist, ist NICHT geprueft). Leer/aus = nur "Nur pruefen".
# REDAKTOR_LLM_MODUS=aus
# Optional (Vorgaben in Klammern):
# REDAKTOR_LIMIT_STUNDE_IP=20       # Durchlaeufe je Stunde und IP
# REDAKTOR_LIMIT_TAG=150            # Durchlaeufe je Tag gesamt
# REDAKTOR_MAX_ZEICHEN=3500         # laengster erlaubter Eingabetext
# REDAKTOR_LLM_TIMEOUT=150          # Sekunden je KI-Aufruf
# REDAKTOR_FEHLVERSUCHE_STUNDE=10   # falsche Codes je IP und Stunde, danach Sperre
# REDAKTOR_SITZUNG_SCHLUESSEL=      # leer = Sitzungen gelten bis zum Neustart des Dienstes
